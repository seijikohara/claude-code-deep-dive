{
  "name": "claude-code-deep-dive",
  "version": "0.0.1",
  "private": true,
  "description": "A reference slide deck on every feature of Claude Code 2.1.321, checked against the official docs and the installed binary.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-reveal-css.mjs",
    "dev": "pnpm run vendor && astro dev",
    "build": "pnpm run vendor && astro build",
    "preview": "astro preview",
    "deck:build": "pnpm run vendor && node tools/build.mjs",
    "deck:lint": "node tools/lint.mjs",
    "deck:check": "node tools/check.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "pnpm run vendor && node --test tools/",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "astro": "^7.4.7",
    "reveal.js": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
