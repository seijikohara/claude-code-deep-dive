{
  "name": "claude-code-deep-dive",
  "version": "0.0.1",
  "private": true,
  "description": "A reference on every feature of Claude Code 2.1.321, checked against the official docs and the installed binary.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "lint:site": "node tools/lint.mjs --site dist --only=privacy,coverage,sources,links",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "node --test tools/",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "hast-util-to-text": "^4.0.3",
    "lefthook": "^2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-stringify": "^11.0.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "packageManager": "pnpm@12.18.0"
}
