{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@fontsource/**"]
      }
    ]
  },
  "ignorePatterns": ["dist", ".astro", "node_modules"]
}
