---
/**
 * Draw steps that repeat in order, with an arrow from the last step back to the first.
 */
interface Props {
  /** Step names, in order. */
  steps: string[];
  /** Label on the arrow that returns to the first step. */
  back?: string;
}
const { steps, back } = Astro.props;
---

<div class="loop" style={`--n: ${steps.length}`}>
  <ol>
    {steps.map((s) => <li>{s}</li>)}
  </ol>
  <div class="back">
    <div class="u" aria-hidden="true"></div>
    {back && <span>{back}</span>}
  </div>
</div>

<style>
  .loop {
    display: grid;
    gap: 0.3rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
    gap: 1.6rem;
  }
  li {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, var(--ccdd-hairline));
    border-radius: 0.75rem;
    display: grid;
    place-items: center;
    padding: 0.55rem 0.6rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    background-color: var(--ccdd-surface);
  }
  li + li::before {
    content: "→";
    position: absolute;
    inset-inline-start: -1.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-weight: 400;
    color: var(--sl-color-accent);
  }
  /* A U-shaped line under the row, from the middle of the last step back up to the first. */
  .back {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    color: var(--sl-color-accent);
  }
  .u {
    position: relative;
    justify-self: stretch;
    height: 0.75rem;
    margin-inline: calc(50% / var(--n));
    border: 1.5px solid currentColor;
    border-top: 0;
    border-radius: 0 0 0.5rem 0.5rem;
  }
  .u::before {
    content: "";
    position: absolute;
    inset-inline-start: -5.5px;
    top: -6px;
    border-inline: 4.5px solid transparent;
    border-bottom: 6px solid currentColor;
  }
  .back span {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
