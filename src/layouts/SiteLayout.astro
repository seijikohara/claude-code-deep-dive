---
import "@fontsource/ibm-plex-sans-jp/400.css";
import "@fontsource/ibm-plex-sans-jp/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "en" ? "ja" : "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("site.title")}</title>
    <meta name="description" content={t("site.description")} />
    <link rel="icon" href="data:," />
    <link rel="alternate" hreflang={other} href={getRelativeLocaleUrl(other, "")} />
  </head>
  <body>
    <header>
      <a class="lang" href={getRelativeLocaleUrl(other, "")} lang={other}>{languages[other]}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>{t("footer.unofficial")}</p>
      <p><a href="https://github.com/seijikohara/claude-code-deep-dive">{t("footer.source")}</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #1b1f24;
    --ink-2: #5a626e;
    --ink-3: #8b929c;
    --rule: #e4e7eb;
    --term-bg: #15181d;
    --term-fg: #e3e6ea;
    --term-dim: #8a929e;
    --font-sans: "IBM Plex Sans JP", "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
    --font-mono: "IBM Plex Mono", "SFMono-Regular", Menlo, Consolas, monospace;
    color-scheme: light;
  }
  html,
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.75;
  }
  body {
    max-width: 880px;
    margin-inline: auto;
    padding-block: 32px 56px;
    padding-left: max(20px, env(safe-area-inset-left, 0px));
    padding-right: max(20px, env(safe-area-inset-right, 0px));
  }
  header {
    display: flex;
    justify-content: flex-end;
  }
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #b9c0ca;
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration-color: var(--ink);
  }
  a:focus-visible {
    outline: 2px solid #1f5bd8;
    outline-offset: 2px;
  }
  h1 {
    font-size: clamp(44px, 9vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 72px 0 28px;
    text-wrap: balance;
  }
  h2 {
    font-size: 22px;
    font-weight: 600;
    margin: 56px 0 14px;
  }
  .lead {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 65ch;
  }
  .term {
    font-family: var(--font-mono);
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: 8px;
    padding: 16px 22px;
    margin: 32px 0 0;
    font-size: 15px;
    overflow-x: auto;
  }
  .term .dim {
    color: var(--term-dim);
  }
  .editions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px 48px;
  }
  .editions > div {
    min-width: 0;
  }
  .editions h3 {
    font-size: 18px;
    margin: 0 0 4px;
  }
  .editions p {
    margin: 0 0 8px;
    color: var(--ink-2);
  }
  .open {
    font-weight: 600;
  }
  ul {
    padding-left: 1.2em;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .keys {
    color: var(--ink-3);
    font-size: 15px;
  }
  footer {
    margin-top: 72px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 14px;
  }
  footer p {
    margin: 0 0 4px;
  }
</style>
