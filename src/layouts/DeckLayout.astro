---
import "@fontsource/ibm-plex-sans-jp/300.css";
import "@fontsource/ibm-plex-sans-jp/400.css";
import "@fontsource/ibm-plex-sans-jp/500.css";
import "@fontsource/ibm-plex-sans-jp/600.css";
import "@fontsource/ibm-plex-sans-jp/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../../vendor/reset.css";
import "../../vendor/reveal.css";
import "../../vendor/white.css";
import "../deck.css";
import { renderSlides } from "../../tools/lib/deck.mjs";

interface Props {
  lang: "en" | "ja";
  title: string;
  description: string;
  /** Chapter sources for this edition, relative to the project root. */
  chaptersDir: string;
}

const { lang, title, description, chaptersDir } = Astro.props;
// Astro runs the build from the project root, so the renderer resolves chapter and data paths from there.
const { slides } = renderSlides({ projectRoot: process.cwd(), chaptersDir });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <div class="reveal"><div class="slides" set:html={slides} /></div>
    <script>
      import Reveal from "reveal.js";
      import RevealHighlight from "reveal.js/plugin/highlight";
      import RevealSearch from "reveal.js/plugin/search";
      import RevealZoom from "reveal.js/plugin/zoom";

      await Reveal.initialize({
        width: 1600,
        height: 900,
        margin: 0.03,
        minScale: 0.1,
        maxScale: 2,
        center: false,
        hash: true,
        slideNumber: "c/t",
        progress: true,
        controls: true,
        controlsLayout: "edges",
        controlsTutorial: false,
        transition: "none",
        backgroundTransition: "none",
        plugins: [RevealHighlight, RevealSearch, RevealZoom],
      });
      // tools/check.mjs drives the deck through the global Reveal API.
      Object.assign(window, { Reveal });
    </script>
  </body>
</html>
